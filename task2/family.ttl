@prefix : <http://example.org/family#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/family#> .

<http://example.org/family> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://www.w3.org/2002/07/owl#asymmetricProperty
owl:asymmetricProperty rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#functionalProperty
owl:functionalProperty rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#irreflexiveProperty
owl:irreflexiveProperty rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2002/07/owl#transitiveProperty
owl:transitiveProperty rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/family#ИмеетПотомка
:ИмеетПотомка rdf:type owl:ObjectProperty ;
              owl:inverseOf :ИмеетПредка .


###  http://example.org/family#ИмеетПредка
:ИмеетПредка rdf:type owl:ObjectProperty ,
                      owl:TransitiveProperty .


###  http://example.org/family#ИмеетРодителя
:ИмеетРодителя rdf:type owl:ObjectProperty ;
               rdfs:subPropertyOf :ИмеетПредка ;
               rdfs:domain :Человек ;
               rdfs:range :Человек ;
               rdf:type owl:FunctionalProperty ,
                        owl:IrreflexiveProperty .


#################################################################
#    Classes
#################################################################

###  http://example.org/family#Человек
:Человек rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://example.org/family#Алексей
:Алексей rdf:type owl:NamedIndividual ,
                  :Человек .


###  http://example.org/family#Борис
:Борис rdf:type owl:NamedIndividual ,
                :Человек ;
       :ИмеетРодителя :Алексей .


###  http://example.org/family#Виктор
:Виктор rdf:type owl:NamedIndividual ,
                 :Человек ;
        :ИмеетРодителя :Борис .


###  http://example.org/family#Георгий
:Георгий rdf:type owl:NamedIndividual ,
                  :Человек ;
         :ИмеетРодителя :Фёдор .


###  http://example.org/family#Григорий
:Григорий rdf:type owl:NamedIndividual ,
                   :Человек ;
          :ИмеетРодителя :Виктор .


###  http://example.org/family#Дмитрий
:Дмитрий rdf:type owl:NamedIndividual ,
                  :Человек ;
         :ИмеетРодителя :Виктор .


###  http://example.org/family#Елена
:Елена rdf:type owl:NamedIndividual ,
                :Человек ;
       :ИмеетРодителя :Борис .


###  http://example.org/family#Игорь
:Игорь rdf:type owl:NamedIndividual ,
                :Человек ;
       :ИмеетРодителя :Алексей .


###  http://example.org/family#Кирилл
:Кирилл rdf:type owl:NamedIndividual ,
                 :Человек ;
        :ИмеетРодителя :Игорь .


###  http://example.org/family#Фёдор
:Фёдор rdf:type owl:NamedIndividual ,
