@prefix : <http://example.org/waste#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/waste#> .

<http://example.org/waste> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Data properties
#################################################################

###  http://example.org/waste#hasCarcinogenClass
:hasCarcinogenClass rdf:type owl:DatatypeProperty ;
                    rdfs:domain :Waste ;
                    rdfs:range xsd:integer .


###  http://example.org/waste#hasContainsMercury
:hasContainsMercury rdf:type owl:DatatypeProperty ;
                    rdfs:subPropertyOf owl:topDataProperty ;
                    rdfs:domain :Waste ;
                    rdfs:range xsd:boolean .


###  http://example.org/waste#hasSumHazardIndex
:hasSumHazardIndex rdf:type owl:DatatypeProperty ;
                   rdfs:domain :Waste ;
                   rdfs:range xsd:float .


###  http://example.org/waste#hasVolatileFraction
:hasVolatileFraction rdf:type owl:DatatypeProperty ;
                     rdfs:domain :Waste ;
                     rdfs:range xsd:float .


#################################################################
#    Classes
#################################################################

###  http://example.org/waste#ClassII_Waste
:ClassII_Waste rdf:type owl:Class ;
               rdfs:subClassOf :HazardousWaste ;
               rdfs:label "Отход II класса опасности"@ru .


###  http://example.org/waste#ClassI_Waste
:ClassI_Waste rdf:type owl:Class ;
              rdfs:subClassOf :HazardousWaste ;
              rdfs:label "Отход I класса опасности"@ru .


###  http://example.org/waste#ClassV_Waste
:ClassV_Waste rdf:type owl:Class ;
              rdfs:subClassOf :Waste ;
              rdfs:label "Отход V класса опасности"@ru .


###  http://example.org/waste#HazardousWaste
:HazardousWaste rdf:type owl:Class ;
                rdfs:subClassOf :Waste ;
                rdfs:label "Опасный отход"@ru .


###  http://example.org/waste#Waste
:Waste rdf:type owl:Class ;
       rdfs:label "Отход"@ru .


#################################################################
#    Individuals
#################################################################

###  http://example.org/waste#AsbestosDebris
:AsbestosDebris rdf:type owl:NamedIndividual ,
                         :Waste ;
                :hasCarcinogenClass 1 ;
                :hasSumHazardIndex "300.0"^^xsd:float ;
                :hasVolatileFraction "0.0"^^xsd:float .


###  http://example.org/waste#Batteries
:Batteries rdf:type owl:NamedIndividual ,
                    :Waste ;
           :hasCarcinogenClass 1 ;
           :hasSumHazardIndex "48000.0"^^xsd:float ;
           :hasVolatileFraction "5.0"^^xsd:float .


###  http://example.org/waste#MercuryLamp
:MercuryLamp rdf:type owl:NamedIndividual ,
                      :Waste ;
             :hasCarcinogenClass 2 ;
             :hasContainsMercury "true"^^xsd:boolean ;
             :hasSumHazardIndex "15000.0"^^xsd:float ;
             :hasVolatileFraction "45.0"^^xsd:float .


###  http://example.org/waste#PlantCompost
:PlantCompost rdf:type owl:NamedIndividual ,
                       :Waste ;
              :hasCarcinogenClass 4 ;
              :hasSumHazardIndex "2.1"^^xsd:float ;
              :hasVolatileFraction "0.3"^^xsd:float .


###  http://example.org/waste#PlasticPackaging
:PlasticPackaging rdf:type owl:NamedIndividual ,
                           :Waste ;
                  :hasCarcinogenClass 4 ;
                  :hasSumHazardIndex "3.5"^^xsd:float ;
                  :hasVolatileFraction "0.1"^^xsd:float .

